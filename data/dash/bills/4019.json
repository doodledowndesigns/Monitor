{"id":4019,"t":"Public Office (Accountability) Bill","long":"A Bill to Impose a duty on public authorities and public officials to act with candour, transparency and frankness; to make provision for the enforcement of that duty in their dealings with inquiries and investigations; to require public authorities to promote and take steps to maintain ethical conduct within all parts of the authority; to create an offence in relation to public authorities and public officials who mislead the public; to create further offences in relation to the misconduct of persons who hold public office and to abolish the common law offence of misconduct in public office; to make provision enabling persons to participate at inquiries and investigations where the conduct of public authorities may be in issue; and for connected purposes.","summary":null,"type":"Government","sponsors":[{"n":"Mr David Lammy","p":"Labour","org":"Ministry of Justice"},{"n":"Baroness Levitt","p":"Labour","org":"Ministry of Justice"}],"house":"Lords","origin":"Commons","stage":"Report stage","stageHouse":"Lords","updated":"2026-10-22","act":false,"withdrawn":false,"defeated":false,"u":"https://bills.parliament.uk/bills/4019","stages":[{"id":20200,"stage":"1st reading","house":"Commons","dates":["2025-09-16"],"amendments":null,"order":1},{"id":20203,"stage":"2nd reading","house":"Commons","dates":["2025-11-03"],"amendments":null,"order":2},{"id":20270,"stage":"Programme motion","house":"Commons","dates":["2025-11-03"],"amendments":null,"order":3},{"id":20264,"stage":"Money resolution","house":"Commons","dates":["2025-11-03"],"amendments":null,"order":4},{"id":20271,"stage":"Committee stage","house":"Commons","dates":["2025-11-27","2025-12-02","2025-12-04"],"amendments":65,"order":5},{"id":20697,"stage":"Carry-over motion","house":"Commons","dates":["2026-04-27"],"amendments":null,"order":6},{"id":20737,"stage":"Bill reintroduced","house":"Commons","dates":["2026-05-14"],"amendments":null,"order":7},{"id":20349,